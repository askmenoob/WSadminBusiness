{
  "name": "wsadmin-business",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @wsadmin-business/api",
    "dev:web": "npm run dev -w @wsadmin-business/web",
    "dev:worker": "npm run dev -w @wsadmin-business/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run check:secrets && npm run typecheck && npm test",
    "db:migrate": "npm run migrate -w @wsadmin-business/database",
    "test:booking-core:db": "tsx scripts/booking-core-acceptance.ts",
    "test:customer-merge:db": "tsx scripts/customer-merge-acceptance.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
