{
  "name": "wsadmin-business",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @wsadmin-business/api",
    "dev:web": "npm run dev -w @wsadmin-business/web",
    "dev:worker": "npm run dev -w @wsadmin-business/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:ui-release": "node scripts/check-ui-release.mjs",
    "check": "npm run check:secrets && npm run check:ui-release && npm run typecheck && npm test",
    "db:migrate": "npm run migrate -w @wsadmin-business/database",
    "test:booking-core:db": "tsx scripts/booking-core-acceptance.ts",
    "test:customer-merge:db": "tsx scripts/customer-merge-acceptance.ts",
    "test:treatments:db": "tsx scripts/treatment-csv-acceptance.ts",
    "test:treatment-sharing:db": "tsx scripts/treatment-sharing-acceptance.ts",
    "test:automation:db": "tsx scripts/automation-acceptance.ts",
    "test:automation-lifecycle:db": "tsx scripts/automation-lifecycle-acceptance.ts",
    "test:marketing:db": "tsx scripts/marketing-acceptance.ts",
    "test:messaging-policy:db": "tsx scripts/messaging-policy-acceptance.ts",
    "test:payments:db": "tsx scripts/payment-acceptance.ts",
    "test:advanced-booking:db": "tsx scripts/advanced-booking-acceptance.ts",
    "test:ai-knowledge:db": "tsx scripts/ai-knowledge-acceptance.ts",
    "test:property-vertical:db": "tsx scripts/property-vertical-acceptance.ts",
    "test:saas:db": "tsx scripts/saas-acceptance.ts",
    "test:tenant-auth-billing:db": "tsx scripts/tenant-auth-billing-acceptance.ts",
    "test:security-privacy:db": "tsx scripts/security-privacy-acceptance.ts",
    "test:performance:db": "tsx scripts/performance-acceptance.ts",
    "test:e2e-technical:db": "tsx scripts/e2e-technical-uat.ts",
    "uat:seed": "tsx scripts/uat-seed.ts",
    "uat:preflight": "tsx scripts/uat-preflight.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
