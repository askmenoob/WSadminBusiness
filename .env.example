NODE_ENV=development
HOST=0.0.0.0
PORT=15280
POSTGRES_DB=wsadmin_business
POSTGRES_USER=wsadmin_business
POSTGRES_PASSWORD=change_me_use_random_secret
DATABASE_URL=postgresql://wsadmin_business:change_me@db:5432/wsadmin_business
REDIS_URL=redis://redis:6379/0
WSADMIN_TIMEZONE=Asia/Kuala_Lumpur
WSADMIN_CURRENCY=MYR
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY_FILE=/run/secrets/evolution_api_key
EVOLUTION_WEBHOOK_TOKEN_FILE=/run/secrets/evolution_webhook_token

GROQ_API_KEY=
GROQ_API_KEY_FILE=
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
WSADMIN_PUBLIC_BASE_URL=http://192.168.0.102:15280

# Tenant authentication. Keep UAT until Google OAuth credentials and redirect URI are registered.
WSADMIN_AUTH_MODE=UAT
WSADMIN_APP_URL=https://wsadmin-biz.imai.my
AUTH_SESSION_TTL_DAYS=30
WSADMIN_TRIAL_DAYS=10
WSADMIN_TRIAL_PLAN_CODE=TRIAL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_REDIRECT_URI=https://wsadmin-biz.imai.my/api/v1/auth/google/callback

# System Owner SaaS subscriptions through the same HitPay provider used by MyPocket.
# MyPocket and WSadmin use separate subscription/entitlement records even when the merchant account is shared.
HITPAY_MODE=DISABLED
HITPAY_API_KEY=
HITPAY_API_KEY_FILE=
HITPAY_WEBHOOK_SALT=
HITPAY_WEBHOOK_SALT_FILE=
HITPAY_BASE_URL=https://api.sandbox.hit-pay.com
HITPAY_RECURRING_METHODS=card

# UAT-only frontend tenant. Production tenant comes from authenticated session.
VITE_UAT_TENANT_ID=
VITE_UAT_ROLE=TENANT_OWNER
